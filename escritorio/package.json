{
  "name": "casadrew-estudio",
  "productName": "CASADREW Estudio",
  "version": "0.5.0",
  "description": "Estudio creativo de Adriana",
  "author": "Adriana (THE NOORKO)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copiar": "node copiar.js",
    "abrir": "npm run copiar && electron .",
    "exe": "npm run copiar && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.thenoorko.casadrew",
    "productName": "CASADREW Estudio",
    "files": [
      "main.js",
      "app/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CASADREW Estudio"
    }
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.0.12"
  }
}
